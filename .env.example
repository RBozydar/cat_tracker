# Deploy-time variables for docker-compose.yml on the Traefik host.
#
# docker-compose automatically loads a ".env" file that sits beside it, so on
# the deploy host, copy this file to ".env" and fill in HOST_SUBDOMAIN. These
# variables are consumed by compose's own variable interpolation — they never
# reach the running app. There are no runtime application env vars read from
# here; see README.md's "Environment variables" section for the ones that do
# reach the app (DATABASE_URL, APP_TIMEZONE) and where compose already sets
# them.

# Feeds two optional Traefik host-rule variants alongside the two literal
# hostnames (cattrack.local.bozydar.me and cattrack.bozydar.me), which always
# work regardless of this variable:
#   cattrack.local.${HOST_SUBDOMAIN}.bozydar.me
#   cattrack.${HOST_SUBDOMAIN}.bozydar.me
# Leaving this unset produces a harmless compose warning at startup and two
# dead double-dot host-rule variants (e.g. "cattrack.local..bozydar.me") that
# never match real traffic — the two literal hostnames above keep working.
# HOST_SUBDOMAIN=

# Already set directly in docker-compose.yml's `environment:` block for the
# cattrack service. Uncomment here only to override, and only if you know why
# (e.g. pointing at a different volume path or reseeding a fresh timezone).
# DATABASE_URL=sqlite:////data/cat_tracker.db
# APP_TIMEZONE=Europe/Warsaw
